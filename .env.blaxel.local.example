# Copy to `.env.blaxel.local` at repo root.
# `.env.blaxel.local` is ignored by git and is intended for local/staging Blaxel keys only.
#
# Keep values quoted so special characters in API keys are parsed correctly by the probe runner.

BL_WORKSPACE=""
BL_API_KEY=""

# Optional probe tuning. Defaults are safe for the first live lifecycle proof.
BLAXEL_WORKSPACE_PROBE_NAME="polynet-blaxel-workspace-manual"
BLAXEL_WORKSPACE_PROBE_IMAGE="blaxel/base-image:latest"
BLAXEL_WORKSPACE_PROBE_MEMORY_MB="4096"
BLAXEL_WORKSPACE_PROBE_REGION="us-pdx-1"
BLAXEL_WORKSPACE_PROBE_VOLUME_SIZE_MB="2048"
BLAXEL_WORKSPACE_PROBE_MOUNT_PATH="/workspace"
BLAXEL_WORKSPACE_PROBE_SERVER_PORT="32123"
BLAXEL_WORKSPACE_PROBE_IDLE_DELETE="1h"
BLAXEL_WORKSPACE_PROBE_MAX_AGE_DELETE="2h"
BLAXEL_WORKSPACE_PROBE_STANDBY_WAIT_MS="90000"
