#
# Convex-First Quickstart (Daytona)
# Copy this file into repo-root `.env`, then replace REPLACE_ME values.
#
# Example:
#   cp .env.convex.quickstart.example .env
#

# Encryption key for provider connection secrets
# - Dev/debug: can stay `dev-only-key`
# - Release/non-debug: must be set to a real secret key
ARX_DB_KEY=dev-only-key

# Core app endpoints (required)
# Convex deployment URL (queries/mutations/probe + Convex-backed gateways)
VITE_CONVEX_URL=https://YOUR_CONVEX_DEPLOYMENT.convex.cloud

# Optional runtime API key header for auth providers that require it.
VITE_CONVEX_PUBLIC_KEY=

# OAuth/OIDC provider endpoints for Convex runtime auth proxy.
# WorkOS AuthKit example values:
# - AUTHKIT_DOMAIN is your AuthKit domain (for example, auth.example.com or <slug>.authkit.app)
ARX_AUTH_AUTHORIZE_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/authorize
ARX_AUTH_TOKEN_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/token
ARX_AUTH_CLIENT_ID=YOUR_AUTHKIT_CLIENT_ID
ARX_AUTH_CLIENT_SECRET=
ARX_AUTH_SCOPE=openid profile email offline_access
ARX_AUTH_AUDIENCE=
# Optional: query key for provider selection in authorize URL (for example, `connection`)
ARX_AUTH_PROVIDER_QUERY_KEY=
ARX_AUTH_LOGOUT_URL=
ARX_AUTH_MAGIC_LINK_URL=

# Convex verified JWT identity provider (required).
# WorkOS AuthKit example values:
ARX_AUTH_JWT_ISSUER=https://YOUR_AUTHKIT_DOMAIN
ARX_AUTH_JWT_JWKS_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/jwks
ARX_AUTH_JWT_AUDIENCE=
ARX_MCP_RESOURCE_URL=https://YOUR_POLYNET_ORIGIN/runtime/mcp
ARX_MCP_AUTH_JWT_AUDIENCE=https://YOUR_POLYNET_ORIGIN/runtime/mcp
ARX_AUTH_JWT_ALGORITHM=RS256
VITE_AUTH_JWT_ISSUER=https://YOUR_AUTHKIT_DOMAIN
# Dev-only escape hatch. Keep false for real auth enforcement.
ARX_ALLOW_UNVERIFIED_AUTH_SUBJECT=false

# Optional but recommended
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_ENABLE_RUNTIME_TURN_V2=true
VITE_ARX_CANONICAL_GATES_V1=1
VITE_ARX_CANONICAL_GATES_PARITY_LOG=0

# Optional: remote MCP host origins allowed to call /runtime/mcp when they
# send an Origin header. Leave blank if your MCP clients do not send Origin.
ARX_ALLOWED_MCP_ORIGINS=

# Optional but recommended before auth-tenant cutover.
# Used by the operator-only auth migration preflight audit.
ARX_AUTH_MIGRATION_AUDIT_SECRET=

# Voice transcription (required only if testing voice)
ARX_VOICE_TRANSCRIBE_ENABLED=true
ARX_VOICE_PRIMARY_MODEL=gpt-4o-mini-transcribe
ARX_VOICE_FALLBACK_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
