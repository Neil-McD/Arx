#
# Copy to `.env` at repo root (this file is safe to commit; `.env` is not).
#
# - Web UI (Vite) reads `VITE_*` values from `.env`.
# - Cloud Functions do NOT read your local `.env`; they read secrets stored in your cloud provider.
#
# To set Convex deployment env vars, use:
#   Convex Dashboard → Deployment Settings → Environment Variables
#
# Tip: it’s fine to keep the same keys/values in your local `.env` for copy/paste,
# but do NOT commit `.env`.

# Local-at-rest encryption key for provider connection secrets.
# - Dev builds may use `dev-only-key`.
# - Production deployments must use a real secret value.
ARX_DB_KEY=dev-only-key
# Required for operator-only auth maintenance and migration preflight audit.
ARX_AUTH_MIGRATION_AUDIT_SECRET=
# Required for workspace preview proxy token signing.
# Set the same value in Convex/runtime and the dedicated preview proxy deployment.
ARX_PREVIEW_PROXY_SIGNING_SECRET=

# Required for short-lived Codex-in-Blaxel bridge callback tokens.
ARX_CODEX_BRIDGE_SIGNING_SECRET=
# Required for operator-only bridge smoke actions.
POLYNET_CODEX_BRIDGE_OPERATOR_SECRET=
# Required staging-only auth source for the Codex exec bridge smoke.
POLYNET_CODEX_BRIDGE_OPENAI_API_KEY=
POLYNET_CODEX_BRIDGE_CODEX_NPM_SPEC=@openai/codex@0.137.0
POLYNET_CODEX_BRIDGE_CODEX_MODEL=

# Required for community source URL ingestion.
# `ARX_SOURCE_URL_FETCHER_ENDPOINT` belongs in Convex/runtime.
# `ARX_SOURCE_URL_FETCHER_SECRET` must match in Convex/runtime and the Vercel broker function.
ARX_SOURCE_URL_FETCHER_ENDPOINT=
ARX_SOURCE_URL_FETCHER_SECRET=

# Required for the Community Launch Knowledge resource builder.
# Must be a direct OpenAI Responses model id, not a PolyNet provider/model ref.
ARX_COMMUNITY_WIKI_ARCHITECT_MODEL=
# Optional override. If unset, the content writer uses ARX_COMMUNITY_WIKI_ARCHITECT_MODEL.
ARX_COMMUNITY_RESOURCE_CONTENT_WRITER_MODEL=

# Recommended dedicated origin for workspace app previews.
# Example: https://polynet-preview-proxy.fly.dev or https://preview.polynet.ai
VITE_WORKSPACE_PREVIEW_ORIGIN=

# Optional browser override for the WS-capable live desktop proxy.
# Recommended to point at the same dedicated preview proxy origin.
VITE_WORKSPACE_LIVE_DESKTOP_PROXY_ORIGIN=

# Optional browser error monitoring.
# - `VITE_SENTRY_DSN` is safe for the browser bundle.
# - `SENTRY_ORG`, `SENTRY_PROJECT`, and `SENTRY_AUTH_TOKEN` are build-time only and used for source map upload.
# - `VITE_SENTRY_ENVIRONMENT` / `VITE_SENTRY_RELEASE` are optional overrides.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional browser product analytics.
# - `VITE_PUBLIC_POSTHOG_KEY` and `VITE_PUBLIC_POSTHOG_HOST` are safe for the browser bundle.
# - Leave unset to disable PostHog cleanly.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# Convex runtime (required)
VITE_CONVEX_URL=
# Optional API key header for runtime fetches if your auth provider requires one.
VITE_CONVEX_PUBLIC_KEY=

# Shared OAuth/OIDC metadata used by Convex MCP auth discovery.
ARX_AUTH_AUTHORIZE_URL=
ARX_AUTH_TOKEN_URL=
ARX_AUTH_CLIENT_ID=
# Same-origin desktop Google auth continuity bridge.
# - `ARX_AUTH_BRIDGE_SECRET` signs the opaque auth flow + session cookies and
#   authorizes root `/api/auth/*` to call the Convex bridge routes.
# - `ARX_AUTH_SESSION_COOKIE_DOMAIN` is optional for cross-subdomain cookies.
# - `ARX_AUTH_SESSION_COOKIE_MAX_AGE_SECONDS` defaults to 30 days when unset.
ARX_AUTH_BRIDGE_SECRET=
ARX_AUTH_SESSION_COOKIE_DOMAIN=
ARX_AUTH_SESSION_COOKIE_MAX_AGE_SECONDS=
# WorkOS AuthKit example:
# ARX_AUTH_AUTHORIZE_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/authorize
# ARX_AUTH_TOKEN_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/token
# ARX_AUTH_CLIENT_ID=YOUR_AUTHKIT_CLIENT_ID
# Optional metadata hint:
ARX_AUTH_SCOPE=openid profile email offline_access

# Convex verified JWT identity provider (recommended for auth hardening).
# If unset, Convex falls back to unauthenticated mode for query/mutation identity.
# Required for verified Convex identity:
ARX_AUTH_JWT_ISSUER=
ARX_AUTH_JWT_JWKS_URL=
ARX_AUTH_JWT_AUDIENCE=
# WorkOS AuthKit example:
# ARX_AUTH_JWT_ISSUER=https://YOUR_AUTHKIT_DOMAIN
# ARX_AUTH_JWT_JWKS_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/jwks
ARX_AUTH_JWT_ALGORITHM=RS256
# Optional client-side issuer hint for session sanity checks in the web UI.
VITE_AUTH_JWT_ISSUER=
# Dev-only escape hatch. Leave unset/false in real environments.
# When false, authenticated Convex calls require verified JWT identity.
ARX_ALLOW_UNVERIFIED_AUTH_SUBJECT=false

# Public app URL used for share links (invites/checkout links, etc.)
VITE_PUBLIC_APP_URL=http://localhost:5173
# Optional legacy alias (some older code paths still fall back to this)
VITE_APP_URL=

# Feature flag: route authenticated cloud chat turns through `runtime_turn`.
# - "true" (default): runtime_turn-first canonical path.
# - "false": legacy fallback path (debug only).
VITE_ENABLE_RUNTIME_TURN_V2=true

# ---------------------------------------------------------------------------
# Cloud Functions (payments)
# ---------------------------------------------------------------------------
# Optional: only needed if you’re developing/deploying Stripe checkout + webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PLAN_BUILDER_PRICE_ID=
STRIPE_BUILDER_PLAN_PRO_PRICE_ID=

# Comma-separated app origins used by server-side redirect validation and strict CORS
# on private/auth runtime routes (agent inference, billing/connect, automations manage/worker).
# Example: https://arx.app,https://arx-teal.vercel.app,http://localhost:5173,http://localhost:1420
ARX_ALLOWED_APP_ORIGINS=

# Comma-separated remote MCP host origins allowed to call the PolyNet MCP endpoint
# when they send an Origin header. Browser-style MCP hosts should be listed here;
# non-browser clients without an Origin header are authenticated by bearer token only.
# Example: https://claude.ai,https://chat.openai.com
ARX_ALLOWED_MCP_ORIGINS=

# Used by: cloud join-link function.
# If you don’t use join links yet, you can leave this blank.
ARX_JOIN_PAGE_URL=

# ---------------------------------------------------------------------------
# Cloud Functions (platform inference; builders only)
# Used by:
# - cloud `agent_turn` (web/community inference router)
# - cloud `platform_agent_infer` (platform reasoning route)
# ---------------------------------------------------------------------------

# Optional kill switch for Arx-provided inference (paid builders).
# If unset, platform inference is treated as enabled. Set to "false" to disable.
ARX_PLATFORM_INFERENCE_ENABLED=

# Defense-in-depth cap on platform completion tokens (clamped server-side).
ARX_PLATFORM_INFERENCE_MAX_TOKENS=512

# Model routing + allowlist is stored in cloud data:
#   public.model_registry (cloud-canonical)
#
# Recommended (simplest):
# - Edit `model_registry` rows in your cloud data store.
# - Populate `provider_model` for each model id (then no env mapping is needed).
#
# Transition fallback (optional):
# If `provider_model` is NULL in `model_registry`, Arx falls back to this mapping.
# Format: JSON object mapping UI model ids -> "<provider>/<provider_model>".
# Example:
# PLATFORM_MODEL_MAP_JSON={"gpt-5.2":"openai/REPLACE_ME","sonnet-4.5":"anthropic/REPLACE_ME","opus-4.6":"anthropic/claude-opus-4-6","gemini-3-flash":"google/REPLACE_ME","grok-4.1":"x-ai/REPLACE_ME"}
PLATFORM_MODEL_MAP_JSON=

# Provider keys for platform inference (set these as cloud function secrets).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Voice transcription (web mic UX)
# - Primary model: OpenAI gpt-4o-mini-transcribe
# - Fallback model: Groq whisper-large-v3-turbo
# - Optional explicit key overrides:
#   ARX_VOICE_PRIMARY_API_KEY, ARX_VOICE_FALLBACK_API_KEY
ARX_VOICE_TRANSCRIBE_ENABLED=true
ARX_VOICE_PRIMARY_MODEL=gpt-4o-mini-transcribe
ARX_VOICE_FALLBACK_MODEL=whisper-large-v3-turbo

# Optional; defaults to 2023-06-01 when unset.
ANTHROPIC_VERSION=2023-06-01

# Deprecated legacy single-model mapping (ignored when PLATFORM_MODEL_MAP_JSON is set).
# Prefer `model_registry` instead.
ARX_PLATFORM_MODEL_REF=
