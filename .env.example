#
# Copy to `.env` at repo root (this file is safe to commit; `.env` is not).
#
# - Web + Desktop UI (Vite) read `VITE_*` values from `.env`.
# - Desktop backend (Tauri) reads non-`VITE_*` values from `.env` too.
# - Supabase Edge Functions do NOT read your local `.env`; they read secrets stored in Supabase.
#
# To set Edge Function secrets, use Supabase Dashboard:
#   Project Settings → Edge Functions → Secrets
#
# Tip: it’s fine to keep the same keys/values in your local `.env` for copy/paste,
# but do NOT commit `.env`.

# ---------------------------------------------------------------------------
# Desktop (Tauri) local state (dev only)
# ---------------------------------------------------------------------------
# Optional: local-at-rest encryption key for Desktop state.
# When unset, Desktop uses a dev default.
ARX_DB_KEY=dev-only-key

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# Supabase (required)
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME

# Optional: override OAuth redirect target (defaults to window.location.origin)
VITE_SUPABASE_REDIRECT_URL=

# Public app URL used for share links (invites/checkout links, etc.)
# If unset, the app will fall back to your Supabase project's Edge Functions domain when VITE_SUPABASE_URL is set.
VITE_PUBLIC_APP_URL=http://localhost:5173
# Optional legacy alias (some older code paths still fall back to this)
VITE_APP_URL=

# ---------------------------------------------------------------------------
# Supabase Edge Functions (payments)
# ---------------------------------------------------------------------------
# Optional: only needed if you’re developing/deploying Stripe checkout + webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PLAN_BUILDER_PRICE_ID=
STRIPE_BUILDER_PLAN_PRO_PRICE_ID=

# Used by: `supabase/functions/c` (join links).
# If you don’t use join links yet, you can leave this blank.
ARX_JOIN_PAGE_URL=

# ---------------------------------------------------------------------------
# Supabase Edge Functions (platform inference; builders only)
# Used by:
# - `supabase/functions/openrouter_turn` (web inference router)
# - `supabase/functions/platform_agent_infer` (desktop agent harness proxy)
# ---------------------------------------------------------------------------

# Master switch for Arx-provided inference.
ARX_PLATFORM_INFERENCE_ENABLED=false

# Defense-in-depth cap on platform completion tokens (clamped server-side).
ARX_PLATFORM_INFERENCE_MAX_TOKENS=512

# Map the UI model picker IDs (e.g. threads.model_id) -> provider model IDs.
# Values are "<provider>/<model>", where provider is one of: openai, anthropic, google, x-ai
PLATFORM_MODEL_MAP_JSON={"gpt-5.2":"openai/REPLACE_ME","gpt-5.1":"openai/REPLACE_ME","sonnet-4.5":"anthropic/REPLACE_ME","opus-4.5":"anthropic/REPLACE_ME","gemini-3-flash":"google/REPLACE_ME","gemini-3-pro":"google/REPLACE_ME","grok-4.1":"x-ai/REPLACE_ME"}

# Provider keys for platform inference (set these as Supabase Edge Function secrets).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional; defaults to 2023-06-01 when unset.
ANTHROPIC_VERSION=2023-06-01

# Legacy (optional): single platform model mapping (ignored when PLATFORM_MODEL_MAP_JSON is set).
ARX_PLATFORM_MODEL_REF=
