# Local database encryption key (dev only)
ARX_DB_KEY=dev-only-key

# OpenAI-compatible
ARX_OPENAI_API_KEY=
ARX_OPENAI_BASE_URL=https://api.openai.com/v1
ARX_OPENAI_MODEL=gpt-4o-mini

# Anthropic
ARX_ANTHROPIC_API_KEY=
ARX_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
ARX_GOOGLE_API_KEY=
ARX_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# xAI
ARX_XAI_API_KEY=
ARX_XAI_BASE_URL=https://api.x.ai

# Supabase (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public app URL used for share links (invite links, etc.)
# If unset, the app will fall back to your Supabase project's Edge Functions domain
# (e.g. https://<project_ref>.functions.supabase.co) when VITE_SUPABASE_URL is set.
VITE_PUBLIC_APP_URL=
