# Cloud auth/runtime
# This app reads env from repo root `.env` (see `../../.env.example`).
# - `VITE_CONVEX_URL` is required.
# - `VITE_CONVEX_PUBLIC_KEY` is optional (header sent only when provided).
VITE_CONVEX_URL=
VITE_CONVEX_PUBLIC_KEY=

# Native WorkOS/AuthKit browser integration.
# Production sign-in now expects this block to be configured.
# `VITE_WORKOS_API_HOSTNAME` is only needed if you have a custom WorkOS auth API domain.
# Without it, the app enables AuthKit `devMode`, which keeps the refresh token in browser storage.
# VITE_WORKOS_CLIENT_ID=
# VITE_WORKOS_API_HOSTNAME=
# VITE_WORKOS_REDIRECT_URI=https://www.polynet.ai/workspace
# VITE_WORKOS_DEV_MODE=true

# Optional OAuth/OIDC proxy config (normally inherited from repo root .env)
# ARX_AUTH_BRIDGE_SECRET=
# ARX_AUTH_SESSION_COOKIE_DOMAIN=.polynet.ai
# ARX_AUTH_SESSION_COOKIE_MAX_AGE_SECONDS=2592000
# ARX_AUTH_AUTHORIZE_URL=
# ARX_AUTH_TOKEN_URL=
# ARX_AUTH_CLIENT_ID=
# WorkOS AuthKit example:
# ARX_AUTH_AUTHORIZE_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/authorize
# ARX_AUTH_TOKEN_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/token
# ARX_AUTH_CLIENT_ID=YOUR_AUTHKIT_CLIENT_ID
# ARX_AUTH_SCOPE=openid profile email offline_access

# Optional Convex JWT provider overrides (normally inherited from repo root .env)
# ARX_AUTH_JWT_ISSUER=
# ARX_AUTH_JWT_JWKS_URL=
# ARX_AUTH_JWT_AUDIENCE=
# WorkOS AuthKit example:
# ARX_AUTH_JWT_ISSUER=https://YOUR_AUTHKIT_DOMAIN
# ARX_AUTH_JWT_JWKS_URL=https://YOUR_AUTHKIT_DOMAIN/oauth2/jwks
# ARX_AUTH_JWT_ALGORITHM=RS256
# VITE_AUTH_JWT_ISSUER=
# ARX_ALLOW_UNVERIFIED_AUTH_SUBJECT=false

# Feature flag: route authenticated cloud chat turns through `runtime_turn`.
# VITE_ENABLE_RUNTIME_TURN_V2=true

# Recommended: dedicated origin for workspace app previews.
# This should point at the Fly preview proxy so arbitrary app assets and websocket paths stay on one preview origin.
# Examples:
# VITE_DAYTONA_PREVIEW_ORIGIN=https://polynet-preview-proxy.fly.dev
# VITE_DAYTONA_PREVIEW_ORIGIN=https://preview.polynet.ai

# Recommended for live desktop / computer-use viewer too.
# Keep this aligned with the dedicated preview proxy origin.
# VITE_DAYTONA_LIVE_DESKTOP_PROXY_ORIGIN=https://polynet-preview-proxy.fly.dev

# Optional browser error monitoring.
# - `VITE_SENTRY_DSN` is safe for the browser bundle.
# - `SENTRY_ORG`, `SENTRY_PROJECT`, and `SENTRY_AUTH_TOKEN` are build-time only and used for source map upload.
# - `VITE_SENTRY_ENVIRONMENT` / `VITE_SENTRY_RELEASE` are optional overrides.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional browser product analytics.
# - `VITE_PUBLIC_POSTHOG_KEY` and `VITE_PUBLIC_POSTHOG_HOST` are browser-safe values.
# - Leave them unset to disable analytics cleanly.
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
