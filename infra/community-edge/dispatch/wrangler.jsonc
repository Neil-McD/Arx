{
  // Local dev (default), the staging edge (`--env staging`) and the production edge (`--env production`).
  // POLYNET_EDGE_SECRET is never committed: .dev.vars locally, a Worker secret when deployed.
  "name": "polynet-community-edge",
  "main": "src/index.ts",
  // The live-updates client is served as text from /__polynet/live.js.
  "rules": [{ "type": "Text", "globs": ["**/*.bundle.js"], "fallthrough": true }],
  "compatibility_date": "2026-09-30",
  "vars": {
    "POLYNET_API_URL": "https://quick-porcupine-949.convex.site",
    "POLYNET_AUTH_URL": "https://polynet-staging.vercel.app",
    "POLYNET_LIVE_URL": "https://quick-porcupine-949.convex.cloud",
    // Host -> { script, community }. Deployed edges use the ROUTES KV namespace instead.
    "DEV_ROUTES_JSON": "{\"hello.localhost\":{\"script\":\"hello\",\"community\":\"polynet\"}}"
  },
  "services": [{ "binding": "DEV_USER_WORKER", "service": "polynet-community-hello" }],
  "env": {
    // Every <community>.polynet.page site, served from the dispatch namespace, against staging.
    "staging": {
      "name": "polynet-edge-staging",
      "workers_dev": false,
      // Staging shares polynet.page with production: <slug>-staging.polynet.page and
      // the front door at staging.polynet.page. These routes are more specific than
      // production's *.polynet.page, so they win.
      "routes": [
        { "pattern": "*-staging.polynet.page/*", "zone_name": "polynet.page" },
        { "pattern": "staging.polynet.page/*", "zone_name": "polynet.page" }
      ],
      "vars": {
        "POLYNET_API_URL": "https://quick-porcupine-949.convex.site",
        "POLYNET_AUTH_URL": "https://polynet-staging.vercel.app",
        "POLYNET_LIVE_URL": "https://quick-porcupine-949.convex.cloud",
        "POLYNET_SITES_DOMAIN": "polynet.page",
        "POLYNET_SITES_HOST_SUFFIX": "-staging",
        "POLYNET_SITES_FRONT_DOOR": "staging.polynet.page"
      },
      "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "polynet-sites-staging" }],
      "kv_namespaces": [{ "binding": "ROUTES", "id": "1f354dc000c34b919cc2c69249363f9e" }]
    },
    // Every <community>.polynet.page site against production, and the front door at polynet.page.
    "production": {
      "name": "polynet-edge-production",
      "workers_dev": false,
      "routes": [
        { "pattern": "*.polynet.page/*", "zone_name": "polynet.page" },
        { "pattern": "polynet.page/*", "zone_name": "polynet.page" }
      ],
      "vars": {
        "POLYNET_API_URL": "https://wry-hawk-715.convex.site",
        "POLYNET_AUTH_URL": "https://www.polynet.ai",
        "POLYNET_LIVE_URL": "https://wry-hawk-715.convex.cloud",
        "POLYNET_SITES_DOMAIN": "polynet.page"
      },
      "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "polynet-sites-production" }],
      "kv_namespaces": [{ "binding": "ROUTES", "id": "c95c9a88c955482aace6430832214b01" }]
    }
  }
}
