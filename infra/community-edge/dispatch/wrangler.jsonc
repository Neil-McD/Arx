{
  // Local spike config. POLYNET_EDGE_SECRET comes from .dev.vars (never committed).
  // Production adds a dispatch_namespaces binding (DISPATCHER)
  // and a KV namespace (ROUTES) instead of the DEV_* values below.
  "name": "polynet-community-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "vars": {
    "POLYNET_API_URL": "https://quick-porcupine-949.convex.site",
    "POLYNET_AUTH_URL": "https://polynet-staging.vercel.app",
    // Host -> { script, community }. Production uses the ROUTES KV namespace instead.
    "DEV_ROUTES_JSON": "{\"hello.localhost\":{\"script\":\"hello\",\"community\":\"polynet\"}}"
  },
  "services": [{ "binding": "DEV_USER_WORKER", "service": "polynet-community-hello" }]
}
