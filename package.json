{
  "name": "arx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev -- --port 5174 --strictPort",
    "build": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "deploy:web:prod": "bash scripts/vercel_prod_deploy.sh",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy -y",
    "convex:codegen": "convex codegen",
    "check:convex-cut-runtime-guard": "bash scripts/convex_cut_runtime_guard.sh",
    "check:legacy-route-surface-guard": "bash scripts/legacy_route_surface_guard.sh",
    "check:no-compat-rpc-primitive-guard": "bash scripts/no_compat_rpc_primitive_guard.sh",
    "check:auth-env-contract-guard": "bash scripts/auth_env_contract_guard.sh",
    "check:auth-runtime-readiness": "bash scripts/auth_runtime_readiness_check.sh",
    "check:no-direct-cloud-auth-imports-guard": "bash scripts/no_direct_cloud_auth_imports_guard.sh",
    "check:legacy-function-transport-surface-guard": "bash scripts/legacy_function_transport_surface_guard.sh",
    "check:convex-client-surface-guard": "bash scripts/convex_client_surface_guard.sh",
    "check:convex-verified-identity-guard": "bash scripts/convex_verified_identity_guard.sh",
    "check:auth-bootstrap-public-identity-guard": "bash scripts/auth_bootstrap_public_identity_guard.sh",
    "check:auth-billing-public-identity-guard": "bash scripts/auth_billing_public_identity_guard.sh",
    "check:community-admin-contract-guard": "bash scripts/community_admin_contract_guard.sh",
    "check:community-public-identity-guard": "bash scripts/community_public_identity_guard.sh",
    "check:runtime-turn-contract-guard": "bash scripts/runtime_turn_contract_guard.sh",
    "check:runtime-router-loop-contract-guard": "bash scripts/runtime_router_loop_contract_check.sh",
    "check:runtime-tool-loop-proof": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/runtime_tool_loop_proof.ts",
    "check:no-legacy-provider-repo-guard": "bash scripts/no_legacy_provider_repo_guard.sh",
    "check:no-platform-fallback-guard": "bash scripts/no_platform_fallback_guard.sh",
    "check:gate-parity": "bash scripts/gate_parity_contract_check.sh",
    "check:foundation-baseline": "bash scripts/foundation_baseline_gate.sh"
  },
  "dependencies": {
    "convex": "^1.32.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.58.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
