{
  "version": 1,
  "name": "community_context_bundle_v1",
  "limits": {
    "query_max_chars": 240,
    "compiled_limit": 12,
    "chat_limit": 6,
    "resource_limit": 5,
    "chat_snippet_max_chars": 260,
    "chat_sender_max_chars": 40,
    "resource_title_max_chars": 80,
    "resource_snippet_max_chars": 220,
    "resource_url_max_chars": 120
  },
  "source_types": {
    "chat": "chat_message",
    "resource": "community_resource",
    "memory": "community_memory"
  },
  "prompt": {
    "header_format": "Community evidence ({community_id})"
  },
  "diagnostics": {
    "fields": [
      "attempted",
      "compiled_fetch_ok",
      "compiled_items_used",
      "compile_version",
      "fallback_used",
      "chat_items_used",
      "resource_items_used"
    ]
  }
}
