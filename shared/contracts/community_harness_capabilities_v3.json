{
  "version": 3,
  "id": "community_harness_capabilities_v3",
  "lane": "chat",
  "intent": "Define the explicit community harness capability surface for read-first retrieval and governed community-memory curation.",
  "runtime_exposed_tools": {
    "web": [
      "community_search",
      "community_memory_candidate_propose"
    ]
  },
  "surface_contract": {
    "web": {
      "workspace_access": false,
      "shell_access": false,
      "file_read_access": false,
      "file_write_access": false
    }
  },
  "denied_tool_names": [
    "read",
    "list_dir",
    "glob",
    "grep",
    "sha256",
    "write",
    "edit",
    "bash",
    "community_chat_post",
    "community_resource_publish",
    "community_artifact_publish"
  ],
  "capability_status_values": [
    "active"
  ],
  "side_effect_classes": [
    "none",
    "read",
    "write",
    "external"
  ],
  "capabilities": [
    {
      "name": "community_search",
      "category": "context",
      "status": "active",
      "surfaces": [
        "web"
      ],
      "side_effect_class": "read",
      "approval_policy": {
        "web": "never"
      },
      "entitlement": {
        "auth_required": true,
        "requires_active_entitlement": true
      },
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 240
          },
          "source_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "chat",
                "resource",
                "memory"
              ]
            },
            "minItems": 1,
            "maxItems": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "verification": {
        "type": "composite_rpc_response",
        "rpcs": [
          "search_compiled_community_context",
          "search_community_memory_items"
        ],
        "success_condition": "http_2xx_and_json_payload",
        "rpc": "search_compiled_community_context"
      },
      "idempotency": {
        "strategy": "pure_read",
        "key_fields": [
          "query",
          "source_types",
          "limit"
        ]
      },
      "slo": {
        "timeout_ms": 9000,
        "max_attempts": 2,
        "retry_backoff_ms": [
          100,
          300
        ]
      }
    },
    {
      "name": "community_memory_candidate_propose",
      "category": "action",
      "status": "active",
      "surfaces": [
        "web"
      ],
      "side_effect_class": "write",
      "approval_policy": {
        "web": "required"
      },
      "entitlement": {
        "auth_required": true,
        "requires_active_entitlement": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "memory_text",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "memory_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "evidence": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "v": {
                "type": "integer"
              },
              "contract_id": {
                "type": "string",
                "maxLength": 128
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "required": [
                    "source_type",
                    "source_id"
                  ],
                  "properties": {
                    "source_type": {
                      "type": "string",
                      "enum": [
                        "chat",
                        "resource",
                        "memory"
                      ]
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "snippet": {
                      "type": "string",
                      "maxLength": 2400
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "score": {
                      "type": "number"
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    }
                  }
                }
              }
            }
          },
          "request_key": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "verification": {
        "type": "post_write_readback",
        "rpc": "community_memory_candidate_propose",
        "success_condition": "candidate_created_or_deduped"
      },
      "idempotency": {
        "strategy": "request_key",
        "key_fields": [
          "memory_text",
          "request_key"
        ]
      },
      "slo": {
        "timeout_ms": 10000,
        "max_attempts": 2,
        "retry_backoff_ms": [
          200,
          500
        ]
      }
    }
  ],
  "execution_requirements": {
    "requires_plan_ir": true,
    "requires_idempotency_keys_for_writes": true,
    "requires_verification_for_side_effects": true,
    "requires_event_audit_trail": true,
    "requires_memory_router": true
  }
}
