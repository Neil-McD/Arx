{
  "version": 3,
  "id": "community_harness_capabilities_v3",
  "lane": "chat",
  "intent": "Define the explicit community harness capability surface for compiled community read context and live feed publishing.",
  "runtime_exposed_tools": {
    "web": [
      "community_search",
      "community_write"
    ]
  },
  "surface_contract": {
    "web": {
      "workspace_access": false,
      "shell_access": false,
      "file_read_access": false,
      "file_write_access": false
    }
  },
  "denied_tool_names": [
    "read",
    "list_dir",
    "glob",
    "grep",
    "sha256",
    "write",
    "edit",
    "bash",
    "community_chat_post",
    "community_resource_publish",
    "community_artifact_publish"
  ],
  "capability_status_values": [
    "active"
  ],
  "side_effect_classes": [
    "none",
    "read",
    "write",
    "external"
  ],
  "capabilities": [
    {
      "name": "community_search",
      "category": "context",
      "status": "active",
      "surfaces": [
        "web"
      ],
      "side_effect_class": "read",
      "approval_policy": {
        "web": "never"
      },
      "entitlement": {
        "auth_required": true,
        "requires_active_entitlement": true
      },
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 240
          }
        }
      },
      "verification": {
        "type": "composite_rpc_response",
        "rpcs": [
          "search_compiled_community_context"
        ],
        "success_condition": "http_2xx_and_json_payload",
        "rpc": "search_compiled_community_context"
      },
      "idempotency": {
        "strategy": "pure_read",
        "key_fields": [
          "query"
        ]
      },
      "slo": {
        "timeout_ms": 9000,
        "max_attempts": 2,
        "retry_backoff_ms": [
          100,
          300
        ]
      }
    },
    {
      "name": "community_write",
      "category": "publication",
      "status": "active",
      "surfaces": [
        "web"
      ],
      "side_effect_class": "write",
      "approval_policy": {
        "web": "never"
      },
      "entitlement": {
        "auth_required": true,
        "requires_active_entitlement": true
      },
      "input_schema": {
        "type": "object",
        "required": [
          "body",
          "evidence"
        ],
        "properties": {
          "post_type": {
            "type": "string",
            "enum": [
              "observation",
              "recommendation",
              "action"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 180
          },
          "body": {
            "type": "string",
            "maxLength": 12000
          },
          "why_now": {
            "type": "string",
            "maxLength": 280
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 180
            },
            "minItems": 1,
            "maxItems": 4
          },
          "publish_confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "novelty_key": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "verification": {
        "type": "composite_rpc_response",
        "rpcs": [
          "write_community_live_feed_item"
        ],
        "success_condition": "http_2xx_and_json_payload",
        "rpc": "write_community_live_feed_item"
      },
      "idempotency": {
        "strategy": "write_with_optional_semantic_dedupe",
        "key_fields": [
          "novelty_key",
          "post_type",
          "title",
          "body"
        ]
      },
      "slo": {
        "timeout_ms": 9000,
        "max_attempts": 1,
        "retry_backoff_ms": [
          0
        ]
      }
    }
  ],
  "execution_requirements": {
    "requires_plan_ir": true,
    "requires_idempotency_keys_for_writes": true,
    "requires_verification_for_side_effects": true,
    "requires_event_audit_trail": true,
    "requires_memory_router": false
  }
}
