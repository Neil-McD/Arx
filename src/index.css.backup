:root {
  font-family: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  color-scheme: light dark;

  /* Light mode (default) */
  --bg-app: #f6f4f0;
  --bg-header: #eeebe5;
  --bg-card: #ffffff;
  --bg-card-alt: #f7f5f1;
  --bg-card-hover: #f3efe8;
  --bg-input: #ffffff;
  --bg-button: #171515;
  --bg-button-text: #f6f4f0;
  --bg-terminal: #0f0f0d;

  --text-primary: #0d0f12;
  --text-secondary: #4b4a45;
  --text-muted: #6a655b;
  --text-faint: #8a857a;
  --text-terminal: #f1ede5;

  --border-default: #dedad3;
  --border-strong: #d8d4cb;
  --border-muted: #c7c0b5;
  --border-active: #0d0f12;

  --icon-default: #6a655b;
  --icon-hover: #3d3a34;
  --icon-active: #0d0f12;

  --hover-overlay: rgba(0, 0, 0, 0.06);
  --active-overlay: rgba(0, 0, 0, 0.1);

  --status-default: #f0ede7;
  --status-proposed: #f7e9c6;
  --status-approved: #cfe6d5;
  --status-executed: #d2d7f0;

  color: var(--text-primary);
  background: var(--bg-app);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg-app: #161616;
    --bg-header: #1c1c1c;
    --bg-card: #242424;
    --bg-card-alt: #1e1e1e;
    --bg-card-hover: #2a2a2a;
    --bg-input: #1e1e1e;
    --bg-button: #f6f4f0;
    --bg-button-text: #161616;
    --bg-terminal: #0f0f0d;

    --text-primary: #f1ede5;
    --text-secondary: #b5b0a6;
    --text-muted: #8a857a;
    --text-faint: #6a655b;
    --text-terminal: #f1ede5;

    --border-default: #333333;
    --border-strong: #3d3d3d;
    --border-muted: #2a2a2a;
    --border-active: #f1ede5;

    --icon-default: #8a857a;
    --icon-hover: #b5b0a6;
    --icon-active: #f1ede5;

    --hover-overlay: rgba(255, 255, 255, 0.06);
    --active-overlay: rgba(255, 255, 255, 0.1);

    --status-default: #2a2a2a;
    --status-proposed: #4a4230;
    --status-approved: #2a3d2e;
    --status-executed: #2e3040;
  }
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  overflow: hidden;
  height: 100%;
  width: 100%;
}

#root {
  height: 100%;
  width: 100%;
  overflow: hidden;
}

.app-root {
  display: grid;
  grid-template-rows: 48px 1fr;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background: var(--bg-app);
}

.app-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px 0 86px;
  background: var(--bg-header);
  -webkit-app-region: drag;
  app-region: drag;
}

.topbar-left,
.topbar-center,
.topbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
  -webkit-app-region: drag;
  app-region: drag;
}

.topbar-left button,
.topbar-center button,
.topbar-right button {
  -webkit-app-region: no-drag;
  app-region: no-drag;
}

/* Workspace Selector in Header */
.workspace-selector {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: transparent;
  border: 1px solid var(--border-default);
  border-radius: 6px;
  cursor: pointer;
  color: var(--text-primary);
  font-size: 12px;
  transition: background 0.15s, border-color 0.15s;
  max-width: 180px;
}

.workspace-selector:hover {
  background: var(--hover-overlay);
  border-color: var(--border-strong);
}

.workspace-selector .workspace-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  fill: none;
  stroke: var(--text-muted);
  stroke-width: 1.5;
}

.workspace-selector .workspace-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}


/* New Session Button in Header */
.new-session-header-btn {
  border: none;
  background: transparent;
  color: var(--icon-default);
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.new-session-header-btn:hover {
  background: var(--hover-overlay);
  color: var(--icon-hover);
}

.new-session-header-btn:active {
  background: var(--active-overlay);
}

.new-session-header-btn svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.topbar-button {
  border: 1px solid var(--border-default);
  background: var(--bg-card);
  color: var(--text-secondary);
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  cursor: pointer;
}

.icon-button {
  border: none;
  background: transparent;
  color: var(--icon-default);
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.icon-button:hover {
  background: var(--hover-overlay);
  color: var(--icon-hover);
}

.icon-button:active {
  background: var(--active-overlay);
}

.icon-button.active {
  color: var(--icon-active);
}

.icon-button svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.app-shell {
  display: grid;
  grid-template-columns: 72px minmax(0, 200px) minmax(0, 1fr) minmax(0, 240px);
  min-height: 0;
  height: 100%;
  overflow: hidden;
  gap: 0;
}

.app-shell.no-left {
  grid-template-columns: 72px minmax(0, 1fr) minmax(0, 240px);
}

.app-shell.no-right {
  grid-template-columns: 72px minmax(0, 200px) minmax(0, 1fr);
}

.app-shell.no-left.no-right {
  grid-template-columns: 72px minmax(0, 1fr);
}

.rail {
  padding: 12px;
  border-right: 1px solid var(--border-default);
  overflow: hidden;
  min-width: 0;
}

.sessions,
.context {
  padding: 12px;
  border-right: 1px solid var(--border-default);
  border-top: 1px solid var(--border-default);
  overflow: hidden;
  min-width: 0;
}

.rail {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  padding: 12px 0;
  background: var(--bg-header);
}

.sessions {
  display: flex;
  flex-direction: column;
  overflow: visible;
  position: relative;
}

.rail-main,
.rail-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.context {
  border-right: none;
  border-left: 1px solid var(--border-default);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.workspace {
  display: grid;
  grid-template-rows: 1fr minmax(120px, 200px) auto;
  padding: 12px;
  gap: 12px;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
  border-top: 1px solid var(--border-default);
}

.ask-bar {
  padding: 10px 12px;
  background: var(--bg-card);
  border: 1px solid var(--border-default);
  border-radius: 10px;
  font-size: 14px;
  display: flex;
  gap: 10px;
  align-items: center;
  flex-shrink: 0;
  min-width: 0;
}

.model-select select {
  border: 1px solid var(--border-default);
  border-radius: 8px;
  padding: 6px 8px;
  font-size: 12px;
  background: var(--bg-input);
  color: var(--text-secondary);
}

.workspace-body {
  border: 1px dashed var(--border-muted);
  border-radius: 12px;
  padding: 16px;
  color: var(--text-secondary);
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
}

.message-item {
  border: 1px solid var(--border-default);
  border-radius: 12px;
  padding: 8px 12px;
  background: var(--bg-card);
  width: fit-content;
  max-width: 75%;
  align-self: flex-start;
}

.message-item.user {
  background: var(--bg-card-hover);
  border-color: var(--border-muted);
  align-self: flex-end;
}

.message-item.debug {
  background: #2b2b2b;
  border-color: #3b3b3b;
  color: #d8d1c5;
  align-self: center;
  font-size: 12px;
}

.message-text {
  font-size: 13px;
  color: var(--text-primary);
  white-space: pre-wrap;
}

.panel-title {
  font-weight: 600;
  margin-bottom: 8px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  flex-shrink: 0;
}


.rail-logo {
  font-weight: 700;
  margin-bottom: 24px;
}

.rail-item {
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  color: var(--icon-default);
  border-radius: 8px;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.rail-item:hover {
  background: var(--hover-overlay);
  color: var(--icon-hover);
}

.rail-item:active {
  background: var(--active-overlay);
}

.rail-item.active {
  color: var(--icon-active);
  background: var(--hover-overlay);
}

.rail-item svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Sessions Header */
.sessions-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  flex-shrink: 0;
  position: relative;
}

.project-selector {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  background: var(--bg-card);
  border: 1px solid var(--border-default);
  border-radius: 8px;
  cursor: pointer;
  min-width: 0;
  color: var(--text-primary);
  font-size: 13px;
  transition: border-color 0.15s;
}

.project-selector:hover {
  border-color: var(--border-strong);
}

.project-selector .project-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  fill: none;
  stroke: var(--text-muted);
  stroke-width: 1.5;
}

.project-selector .project-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-selector .chevron-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  fill: none;
  stroke: var(--text-muted);
  stroke-width: 2;
}

.new-session-btn {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  background: var(--bg-button);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  flex-shrink: 0;
}

.new-session-btn svg {
  width: 18px;
  height: 18px;
  stroke: var(--bg-button-text);
  stroke-width: 2;
  fill: none;
}

.new-session-btn:hover {
  opacity: 0.9;
}

/* Project Dropdown */
.project-dropdown {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: var(--bg-card);
  border: 1px solid var(--border-default);
  border-radius: 10px;
  padding: 8px;
  z-index: 100;
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  max-height: 300px;
  overflow-y: auto;
}

.dropdown-section {
  margin-bottom: 8px;
}

.dropdown-section:last-child {
  margin-bottom: 0;
}

.dropdown-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-faint);
  padding: 4px 8px;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 8px;
  background: transparent;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  color: var(--text-primary);
  font-size: 12px;
  text-align: left;
}

.dropdown-item:hover {
  background: var(--hover-overlay);
}

.dropdown-item.active {
  background: var(--hover-overlay);
  font-weight: 600;
}

.dropdown-item.muted {
  color: var(--text-muted);
}

.dropdown-item-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-item-action {
  font-size: 11px;
  color: var(--text-muted);
}

.dropdown-create {
  display: flex;
  gap: 6px;
  padding: 4px 8px;
}

.dropdown-create input {
  flex: 1;
  min-width: 0;
  padding: 6px 8px;
  font-size: 12px;
  border: 1px solid var(--border-default);
  border-radius: 6px;
  background: var(--bg-input);
  color: var(--text-primary);
}

.dropdown-create button {
  padding: 6px 10px;
  font-size: 11px;
  background: var(--bg-button);
  color: var(--bg-button-text);
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.dropdown-empty {
  padding: 12px 8px;
  font-size: 12px;
  color: var(--text-faint);
  text-align: center;
}

.dropdown-divider {
  height: 1px;
  background: var(--border-default);
  margin: 8px 0;
}

/* Session Groups */
.session-group {
  margin-bottom: 12px;
}

.session-group-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-faint);
  padding: 4px 0;
  margin-bottom: 4px;
}

/* Ask Bar Input */
.ask-bar input {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--border-default);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 14px;
  background: var(--bg-input);
  color: var(--text-primary);
}

.ask-bar button,
.action-buttons button {
  border: none;
  background: var(--bg-button);
  color: var(--bg-button-text);
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
  white-space: nowrap;
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-top: 4px;
}

.session-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 8px 10px;
  background: transparent;
  text-align: left;
  cursor: pointer;
  color: var(--text-primary);
  flex-shrink: 0;
  min-width: 0;
  transition: background 0.15s, border-color 0.15s;
}

.session-item:hover {
  background: var(--hover-overlay);
}

.session-item.active {
  background: var(--bg-card);
  border-color: var(--border-default);
}

.session-content {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-weight: 500;
  font-size: 13px;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-preview {
  font-size: 11px;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  flex-shrink: 0;
}

.session-time {
  font-size: 10px;
  color: var(--text-faint);
}

.session-actions {
  display: flex;
  gap: 4px;
  opacity: 0;
  transition: opacity 0.15s;
}

.session-item:hover .session-actions {
  opacity: 1;
}

.session-action {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  background: transparent;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  color: var(--text-muted);
}

.session-action:hover {
  background: var(--active-overlay);
  color: var(--text-primary);
}

.session-action svg {
  width: 12px;
  height: 12px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow-y: auto;
  overflow-x: hidden;
  flex-shrink: 0;
}

.action-card {
  border: 1px solid var(--border-default);
  border-radius: 10px;
  padding: 12px;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
  min-width: 0;
}

.action-title {
  font-weight: 600;
  font-size: 13px;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-meta {
  display: flex;
  gap: 12px;
  font-size: 12px;
  color: var(--text-muted);
}

.status {
  padding: 2px 8px;
  border-radius: 999px;
  background: var(--status-default);
  color: var(--text-secondary);
}

.status.proposed {
  background: var(--status-proposed);
}

.status.approved {
  background: var(--status-approved);
}

.status.executed {
  background: var(--status-executed);
}

.action-buttons {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.action-buttons button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.action-output {
  background: var(--bg-terminal);
  color: var(--text-terminal);
  padding: 12px;
  border-radius: 8px;
  font-size: 12px;
  max-height: 200px;
  overflow: auto;
  white-space: pre-wrap;
}

.empty-state {
  color: var(--text-faint);
  margin-top: 16px;
}

.terminal-panel {
  border: 1px solid var(--border-default);
  border-radius: 12px;
  background: var(--bg-terminal);
  padding: 12px;
  min-height: 0;
  overflow: hidden;
}

.terminal-root {
  width: 100%;
  height: 100%;
  min-height: 0;
}

.settings-panel {
  border: 1px dashed var(--border-muted);
  border-radius: 12px;
  padding: 16px;
  color: var(--text-secondary);
  background: var(--bg-card);
  overflow-y: auto;
  min-height: 0;
}

.model-list {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.model-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--text-primary);
}

.key-list {
  display: grid;
  gap: 12px;
  margin-top: 12px;
}

.key-row {
  display: grid;
  grid-template-columns: 120px 1fr auto auto;
  gap: 10px;
  align-items: center;
}

.key-label {
  font-size: 13px;
  color: var(--text-primary);
}

.key-row input {
  border: 1px solid var(--border-default);
  border-radius: 8px;
  padding: 6px 8px;
  font-size: 12px;
  background: #fff;
}

.key-row button.secondary {
  background: transparent;
  border: 1px solid var(--border-default);
  color: var(--text-primary);
}

.key-error {
  grid-column: 1 / -1;
  font-size: 12px;
  color: #b64b3a;
}

.terminal-root .xterm-viewport {
  scrollbar-color: #3d3a34 #0f0f0d;
}

.context-body {
  color: var(--text-muted);
  font-size: 12px;
  flex-shrink: 0;
}

.audit-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 8px;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

.audit-item {
  border: 1px solid var(--border-default);
  border-radius: 6px;
  padding: 6px 8px;
  background: var(--bg-card);
  flex-shrink: 0;
}

.audit-meta {
  font-size: 12px;
  color: var(--text-muted);
}

.audit-time {
  font-size: 11px;
  color: var(--text-faint);
  margin-top: 4px;
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 72px minmax(0, 180px) minmax(0, 1fr);
  }

  .app-shell.no-left {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .app-shell.no-right {
    grid-template-columns: 72px minmax(0, 180px) minmax(0, 1fr);
  }

  .app-shell.no-left.no-right {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .context {
    display: none;
  }
}

@media (max-width: 840px) {
  .app-shell,
  .app-shell.no-left,
  .app-shell.no-right,
  .app-shell.no-left.no-right {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .sessions,
  .context {
    display: none;
  }
}
