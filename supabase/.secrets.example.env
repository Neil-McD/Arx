# Supabase Edge Function secrets (do not commit real keys)
#
# 1) Copy this file:
#      cp supabase/.secrets.example.env supabase/.secrets.env
# 2) Paste your keys into `supabase/.secrets.env`
# 3) Push them to Supabase (ARX project):
#      supabase secrets set --project-ref <PROJECT_REF> --env-file supabase/.secrets.env
#
# Note:
# - This is ONLY for Supabase Edge Functions (server-side). Your local `.env` does not affect them.
# - `supabase secrets list --project-ref <PROJECT_REF>` shows names only (not values).

# Comma-separated list of allowed app origins.
# Used by:
# - Redirect URL validation in billing flows.
# - Strict CORS checks for private/auth Edge Functions (agent inference, billing/connect, automations manage/worker).
# Example: https://arx.app,https://arx-teal.vercel.app,http://localhost:5173,http://localhost:1420,https://tauri.localhost
ARX_ALLOWED_APP_ORIGINS=

# Optional kill switch for Arx-provided inference (paid builders).
# If unset/empty, platform inference is treated as enabled. Set to "false" to disable.
ARX_PLATFORM_INFERENCE_ENABLED=

# Defense-in-depth cap on platform completion tokens (clamped server-side).
ARX_PLATFORM_INFERENCE_MAX_TOKENS=512

# Provider keys for platform inference.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Daytona runtime (paid tool-capable turns via runtime_turn).
DAYTONA_API_URL=
DAYTONA_API_KEY=
# Optional org/project scope identifier depending on Daytona setup.
DAYTONA_ORG_ID=
# Optional sandbox defaults for runtime_turn Daytona provisioning.
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=

# Voice transcription defaults (used by functions/voice_transcribe)
ARX_VOICE_TRANSCRIBE_ENABLED=true
ARX_VOICE_PRIMARY_MODEL=gpt-4o-mini-transcribe
ARX_VOICE_FALLBACK_MODEL=whisper-large-v3-turbo

# Optional explicit overrides for voice API keys.
# If unset, function falls back to OPENAI_API_KEY (primary) and GROQ_API_KEY (fallback).
ARX_VOICE_PRIMARY_API_KEY=
ARX_VOICE_FALLBACK_API_KEY=
# Backward-compat alias accepted by the function:
ARX_VOICE_FALLBACK_KEY=

# Optional; defaults to 2023-06-01 when unset.
ANTHROPIC_VERSION=2023-06-01
