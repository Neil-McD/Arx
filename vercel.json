{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "installCommand": "npm ci && npm --prefix apps/web ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/source-url-fetch.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "frame-ancestors 'self'",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    { "src": "/runtime/mcp", "dest": "/api/mcp/runtime" },
    { "src": "/\\.well-known/oauth-protected-resource", "dest": "/api/mcp/oauth-protected-resource" },
    { "src": "/\\.well-known/oauth-authorization-server", "dest": "/api/mcp/oauth-authorization-server" },
    { "handle": "filesystem" },
    { "src": "/(.*\\..*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
