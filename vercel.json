{
  "installCommand": "npm ci && npm --prefix apps/web ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/source-url-fetch.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "frame-ancestors 'self'",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    { "src": "/api/preview(/.*)?", "status": 404 },
    { "src": "/_preview/start(/.*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*\\..*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
